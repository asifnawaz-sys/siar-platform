# SIAR Platform - Production Environment Configuration
# Copy this file to .env and update with production values

# Flask Configuration
FLASK_ENV=production
DEBUG=False
SECRET_KEY=change-this-to-random-secret-key-in-production

# Database Configuration
DATABASE_URL=sqlite:///./data/orders.db
DATABASE_POOL_SIZE=10
DATABASE_POOL_RECYCLE=3600

# JWT Configuration
JWT_SECRET=change-this-to-random-jwt-secret-key
JWT_EXPIRATION_HOURS=24

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
REQUEST_TIMEOUT=30
MAX_WORKERS=4

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Marketplace Configuration
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
AMAZON_SP_API_REGION=na
AMAZON_SELLER_ID=your-seller-id

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/siar_platform.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Security
CORS_ENABLED=True
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
SECURITY_HEADERS_ENABLED=True
HTTPS_REDIRECT=True

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,xlsx,csv,json

# Admin Configuration
ADMIN_EMAIL=admin@siardigital.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-in-first-login
